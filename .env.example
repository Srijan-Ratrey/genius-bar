# Copy to .env and fill in. .env is gitignored.

# Google AI Studio: https://aistudio.google.com/apikey
# Only needed to REGENERATE results. `make eval` replays the committed cache
# and runs with no key at all.
GEMINI_API_KEY=

# Kaggle: Account -> Settings -> API -> Create New Token (gives kaggle.json).
# Both are required; the key alone is not enough to authenticate.
# Only needed for `make data`. The committed subsample means graders can skip it.
KAGGLE_USERNAME=
KAGGLE_KEY=
